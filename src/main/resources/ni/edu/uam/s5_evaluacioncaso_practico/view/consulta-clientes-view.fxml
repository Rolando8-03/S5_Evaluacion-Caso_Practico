<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.s5_evaluacioncaso_practico.controller.ConsultaClientesController"
            prefWidth="900.0" prefHeight="600.0" styleClass="app-root">
    <top>
        <VBox spacing="6.0" styleClass="page-header">
            <padding><Insets top="20.0" right="24.0" bottom="18.0" left="24.0"/></padding>
            <Label text="Consulta de clientes" styleClass="title"/>
            <Label text="Seleccione un cliente y use doble clic o el menú contextual para ver su detalle." styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12.0" styleClass="content-area">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS" onMouseClicked="#manejarMouse">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="230.0"/>
                    <TableColumn fx:id="colTipo" text="Tipo de cliente" prefWidth="170.0"/>
                    <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="140.0"/>
                    <TableColumn fx:id="colSolicitud" text="Tipo de solicitud" prefWidth="180.0"/>
                </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblContador" text="Clientes registrados: 0" styleClass="helper-text"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="footer">
            <padding><Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/></padding>
            <Button text="Cerrar" onAction="#cerrar" styleClass="secondary-button"/>
        </HBox>
    </bottom>
</BorderPane>
