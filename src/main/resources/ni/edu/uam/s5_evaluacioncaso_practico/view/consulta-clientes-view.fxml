<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.s5_evaluacioncaso_practico.controller.ConsultaClientesController"
            prefWidth="960.0"
            prefHeight="620.0"
            styleClass="app-root">

    <top>
        <VBox spacing="4.0"
              styleClass="page-header">

            <padding>
                <Insets top="22.0"
                        right="28.0"
                        bottom="18.0"
                        left="28.0"/>
            </padding>

            <Label text="Consulta de clientes"
                   styleClass="title"/>

            <Label text="Seleccione un cliente para consultar su información."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14.0"
              styleClass="content-area">

            <padding>
                <Insets top="22.0"
                        right="28.0"
                        bottom="22.0"
                        left="28.0"/>
            </padding>

            <Label fx:id="lblCantidadClientes"
                   text="Clientes registrados: 0"
                   styleClass="helper-text"/>

            <TableView fx:id="tablaClientes"
                       onMouseClicked="#manejarDobleClic"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colNombreCompleto"
                                 text="Nombre completo"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="colTipoCliente"
                                 text="Tipo"
                                 prefWidth="140.0"/>

                    <TableColumn fx:id="colCiudad"
                                 text="Ciudad"
                                 prefWidth="140.0"/>

                    <TableColumn fx:id="colFechaNacimiento"
                                 text="Nacimiento"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colTipoSolicitud"
                                 text="Solicitud"
                                 prefWidth="160.0"/>
                </columns>

                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="Ver detalle"
                                      onAction="#verDetalleSeleccionado"/>
                        </items>
                    </ContextMenu>
                </contextMenu>

            </TableView>

            <Label text="Puede hacer doble clic sobre un cliente o utilizar el menú contextual para ver su detalle."
                   wrapText="true"
                   styleClass="helper-text"/>

            <HBox alignment="CENTER_RIGHT"
                  spacing="10.0">

                <Button text="Ver detalle"
                        onAction="#verDetalleSeleccionado"
                        styleClass="primary-button"/>

                <Button text="Cerrar"
                        onAction="#cerrar"
                        styleClass="secondary-button"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>