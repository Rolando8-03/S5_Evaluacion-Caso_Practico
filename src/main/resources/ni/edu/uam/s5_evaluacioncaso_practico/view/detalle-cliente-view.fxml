<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.s5_evaluacioncaso_practico.controller.DetalleClienteController"
            onKeyPressed="#manejarTeclado" focusTraversable="true" prefWidth="760.0" prefHeight="560.0" styleClass="app-root">
    <top>
        <VBox spacing="6.0" styleClass="page-header">
            <padding><Insets top="20.0" right="24.0" bottom="18.0" left="24.0"/></padding>
            <Label text="Detalle del cliente" styleClass="title"/>
            <Label text="Información completa del cliente seleccionado." styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24.0" styleClass="content-area">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <VBox spacing="10.0" prefWidth="470.0" styleClass="card">
                <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                <Label text="Datos generales" styleClass="section-title"/>
                <GridPane hgap="12.0" vgap="10.0">
                    <Label text="ID:" styleClass="field-label" GridPane.rowIndex="0"/>
                    <Label fx:id="lblId" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Nombre:" styleClass="field-label" GridPane.rowIndex="1"/>
                    <Label fx:id="lblNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true"/>
                    <Label text="Tipo de cliente:" styleClass="field-label" GridPane.rowIndex="2"/>
                    <Label fx:id="lblTipoCliente" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Ciudad:" styleClass="field-label" GridPane.rowIndex="3"/>
                    <Label fx:id="lblCiudad" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Fecha de nacimiento:" styleClass="field-label" GridPane.rowIndex="4"/>
                    <Label fx:id="lblFechaNacimiento" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="Solicitud:" styleClass="field-label" GridPane.rowIndex="5"/>
                    <Label fx:id="lblTipoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
                <Label text="Servicios de interés" styleClass="section-title"/>
                <ListView fx:id="listaServicios" prefHeight="120.0" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox spacing="10.0" alignment="TOP_CENTER" prefWidth="210.0" styleClass="card">
                <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                <Label text="Fotografía" styleClass="section-title"/>
                <ImageView fx:id="imgFotografia" fitWidth="160.0" fitHeight="190.0" preserveRatio="true" styleClass="photo-frame"/>
                <Label fx:id="lblFotografia" text="Sin fotografía" wrapText="true" styleClass="helper-text"/>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="footer">
            <padding><Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/></padding>
            <Label text="ESC para cerrar" styleClass="helper-text"/>
            <Button text="Cerrar" onAction="#cerrar" styleClass="secondary-button"/>
        </HBox>
    </bottom>
</BorderPane>
