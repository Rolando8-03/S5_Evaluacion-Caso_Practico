<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.s5_evaluacioncaso_practico.controller.DetalleClienteController"
            onKeyPressed="#manejarTeclado"
            prefWidth="760.0"
            prefHeight="620.0"
            styleClass="app-root"
            focusTraversable="true">

    <top>
        <VBox spacing="4.0"
              styleClass="page-header">

            <padding>
                <Insets top="22.0"
                        right="28.0"
                        bottom="18.0"
                        left="28.0"/>
            </padding>

            <Label text="Detalle del cliente"
                   styleClass="title"/>

            <Label text="Información del cliente seleccionado."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="28.0"
              styleClass="content-area">

            <padding>
                <Insets top="24.0"
                        right="30.0"
                        bottom="24.0"
                        left="30.0"/>
            </padding>

            <!-- Fotografía -->
            <VBox spacing="10.0"
                  alignment="TOP_CENTER"
                  prefWidth="220.0">

                <ImageView fx:id="imgFotografia"
                           fitWidth="190.0"
                           fitHeight="190.0"
                           preserveRatio="true"
                           smooth="true"
                           styleClass="photo-frame"/>

                <Label fx:id="lblEstadoFotografia"
                       text="Sin fotografía"
                       wrapText="true"
                       styleClass="helper-text"/>
            </VBox>

            <!-- Información del cliente -->
            <VBox spacing="18.0"
                  HBox.hgrow="ALWAYS">

                <GridPane hgap="18.0"
                          vgap="14.0">

                    <Label text="Nombre completo:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           styleClass="field-label"/>

                    <Label fx:id="lblNombreCompleto"
                           text="-"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                    <Label text="Tipo de cliente:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           styleClass="field-label"/>

                    <Label fx:id="lblTipoCliente"
                           text="-"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                    <Label text="Ciudad:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"
                           styleClass="field-label"/>

                    <Label fx:id="lblCiudad"
                           text="-"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                    <Label text="Fecha de nacimiento:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"
                           styleClass="field-label"/>

                    <Label fx:id="lblFechaNacimiento"
                           text="-"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

                    <Label text="Tipo de solicitud:"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"
                           styleClass="field-label"/>

                    <Label fx:id="lblTipoSolicitud"
                           text="-"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Servicios de interés -->
                <VBox spacing="8.0">

                    <Label text="Servicios de interés"
                           styleClass="section-title"/>

                    <ListView fx:id="listaServicios"
                              prefHeight="150.0"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Cerrar"
                            onAction="#cerrar"
                            styleClass="primary-button"/>
                </HBox>

                <Label text="Puede presionar ESC para cerrar esta ventana."
                       styleClass="helper-text"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>